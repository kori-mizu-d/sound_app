<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>音が鳴るまでの時間</title>
  <style>
    :root {
      color-scheme: light;
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      color: #172033;
      background: #f2f5fb;
    }

    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    main {
      width: min(100%, 520px);
      padding: 40px;
      text-align: center;
      background: #fff;
      border: 1px solid #e5e9f2;
      border-radius: 24px;
      box-shadow: 0 18px 50px #25365a14;
    }

    .eyebrow {
      margin: 0 0 10px;
      color: #5266d6;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    h1 { margin: 0; font-size: clamp(1.7rem, 6vw, 2.2rem); }

    .description {
      margin: 14px 0 30px;
      color: #667085;
      line-height: 1.7;
    }

    .result {
      margin: 0 0 26px;
      padding: 24px 12px;
      border-radius: 16px;
      background: #f6f7ff;
    }

    .result-label { margin: 0 0 6px; color: #667085; }

    #time {
      margin: 0;
      color: #3949ab;
      font-size: clamp(2.6rem, 12vw, 4rem);
      font-variant-numeric: tabular-nums;
      font-weight: 750;
      line-height: 1.15;
    }

    #status {
      min-height: 1.6em;
      margin: 0 0 20px;
      color: #475467;
    }

    button {
      width: 100%;
      min-height: 56px;
      border: 0;
      border-radius: 12px;
      background: #4b5bdc;
      color: #fff;
      font: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 150ms ease, transform 150ms ease;
    }

    button:hover:not(:disabled) { background: #3c4bc3; }
    button:active:not(:disabled) { transform: scale(0.99); }
    button:disabled { cursor: wait; opacity: 0.7; }

    .note { margin: 18px 0 0; color: #98a2b3; font-size: 0.82rem; }

    @media (max-width: 480px) {
      main { padding: 30px 22px; }
    }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">SOUND TIMER</p>
    <h1>音が鳴るまでの時間</h1>
    <p class="description">スタートを押すと、1〜5秒のランダムな待ち時間のあとに音が鳴ります。</p>
    <section class="result" aria-live="polite">
      <p class="result-label">スタートから音が鳴るまで</p>
      <p id="time">--.--<span style="font-size: 1rem"> 秒</span></p>
    </section>
    <p id="status" role="status">準備ができたらスタートしてください。</p>
    <button id="start" type="button">スタート</button>
    <p class="note">音量を確認してからお試しください。</p>
  </main>
  <script>
    const startButton = document.querySelector("#start");
    const timeDisplay = document.querySelector("#time");
    const statusDisplay = document.querySelector("#status");
    let audioContext;

    function playBeep() {
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = "sine";
      oscillator.frequency.value = 880;
      gain.gain.setValueAtTime(0.0001, audioContext.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.18, audioContext.currentTime + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioContext.currentTime + 0.28);
      oscillator.connect(gain);
      gain.connect(audioContext.destination);
      oscillator.start();
      oscillator.stop(audioContext.currentTime + 0.3);
    }

    startButton.addEventListener("click", async () => {
      startButton.disabled = true;
      timeDisplay.firstChild.textContent = "--.--";
      statusDisplay.textContent = "音が鳴るまでお待ちください…";

      try {
        audioContext ??= new AudioContext();
        await audioContext.resume();
      } catch (error) {
        statusDisplay.textContent = "音を再生できませんでした。ブラウザーの設定をご確認ください。";
        startButton.disabled = false;
        return;
      }

      const startedAt = performance.now();
      const delay = 1000 + Math.random() * 4000;
      window.setTimeout(() => {
        try {
          playBeep();
          const elapsedSeconds = (performance.now() - startedAt) / 1000;
          timeDisplay.firstChild.textContent = elapsedSeconds.toFixed(2);
          statusDisplay.textContent = "音が鳴りました。もう一度試せます。";
        } catch (error) {
          statusDisplay.textContent = "音を再生できませんでした。ブラウザーの設定をご確認ください。";
        } finally {
          startButton.disabled = false;
        }
      }, delay);
    });
  </script>
</body>
</html>
